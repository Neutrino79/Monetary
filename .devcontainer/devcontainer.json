{
  // One-click identical environment for VS Code ("Reopen in Container") and GitHub Codespaces.
  "name": "Monetary",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements-dev.txt && (cd web && npm ci) && (cp -n web/.env.example web/.env.local || true) && git config commit.template .gitmessage && pre-commit install",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API" },
    "5173": { "label": "Web app" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "oxc.oxc-vscode",
        "editorconfig.editorconfig"
      ],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
