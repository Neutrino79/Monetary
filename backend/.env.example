# Backend configuration template. The backend reads plain environment variables (it does NOT
# load this file itself): copy it to `.env`, adjust, and export it, e.g.
#     set -a; source .env; set +a
# or pass the values through your process manager / hosting provider.
# Every value is optional; anything omitted falls back to the default in monetary/config.py.

# "production" (default, safest) or "development". Production disables /docs, /redoc and
# /openapi.json and sends HSTS + baseline security headers.
MONETARY_ENV=development

# Comma-separated browser origins allowed to call the API. Empty/unset = none allowed.
# The Vite dev server runs on http://localhost:5173. "*" disables credentialed requests.
MONETARY_CORS_ORIGINS=http://localhost:5173

# Where everything is stored: control.db (accounts) and tenants/ (one ledger per user).
# Default: ~/.monetary_0.5
# MONETARY_DATA_DIR=/var/lib/monetary
# Single ledger file of an earlier release; adopted in place as the first superuser's ledger.
# MONETARY_DB_PATH=/var/lib/monetary/expense.db

# Force the interactive API docs on or off regardless of MONETARY_ENV (true/false).
# MONETARY_ENABLE_DOCS=false

# User-facing product name and tagline, served by GET /meta (the web app displays these).
# MONETARY_APP_NAME=Monetary
# MONETARY_APP_TAGLINE=Personal expense ledger

# Demo mode (evaluation only, never with real data): serves a generated sample ledger from a separate
# demo.db and lets anyone in via POST /auth/demo. Or just run ./scripts/dev.sh demo.
# MONETARY_DEMO_MODE=false
# With demo mode on: rebuild the sample ledger at every start (default: create once, reuse).
# MONETARY_DEMO_RESET=false
# JSON file replacing the default categories / income sources created at first-run setup.
# Default: the bundled monetary/seed_defaults.json
# MONETARY_SEED_DEFAULTS_PATH=

# --- Account protection (all optional; the values below are the defaults) ---------------------------
# Wrong passwords (or security answers) in a row before an account is locked, and for how long.
# MONETARY_LOGIN_MAX_FAILURES=5
# MONETARY_LOGIN_LOCKOUT_MINUTES=15
# Failed sign-ins from one address before the sign-in form also needs a captcha.
# MONETARY_LOGIN_CAPTCHA_AFTER=3
# How long an administrator-issued temporary password stays valid.
# MONETARY_TEMP_PASSWORD_HOURS=72
# How many times a rejected person can ask again before only a superuser can reopen the request.
# MONETARY_MAX_REREQUESTS=3
# Captcha for sign-up, forgot password and (after failures) sign-in: altcha | turnstile | none.
# MONETARY_CAPTCHA_PROVIDER=altcha
# MONETARY_CAPTCHA_DIFFICULTY=50000
# MONETARY_CAPTCHA_TTL_SECONDS=300
# Only for turnstile:
# MONETARY_TURNSTILE_SITE_KEY=
# MONETARY_TURNSTILE_SECRET=
# Fixed server secret (signs captcha challenges). Unset: a random one is kept in the data folder.
# MONETARY_SECRET_KEY=
