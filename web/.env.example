# Copy this file to `.env.local` and adjust per deployment.
# Every value is optional -- anything omitted falls back to the default in src/config/app.ts.

# ---------------------------------------------------------------- Backend
# Base URL of the API *including the version prefix*. Every service builds its URLs from this.
# The backend must allow this app's origin: run it with MONETARY_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v0.5

# Request timeout for the HTTP client, in milliseconds.
VITE_API_TIMEOUT_MS=15000

# When the connection is lost the app re-checks it, waiting this long first (seconds), doubling each
# time up to the maximum.
VITE_CONNECTION_RETRY_BASE_SECONDS=3
VITE_CONNECTION_RETRY_MAX_SECONDS=30

# --------------------------------------------------------------- Branding
# The product name is owned by the BACKEND (set MONETARY_APP_NAME there; the app reads it from GET /meta).
# These two are only the fallback shown before that response arrives or if the backend is unreachable,
# and the text baked into index.html at build time.
VITE_APP_NAME=Monetary
VITE_APP_TAGLINE=Personal expense ledger

# --------------------------------------------------------------- Locale
# Defaults offered at first-run setup (the owner's real currency/timezone come from the backend).
VITE_CURRENCY_CODE=INR
VITE_LOCALE=en-IN
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_SUPPORT_EMAIL=support@example.com
