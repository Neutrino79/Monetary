{
  // Run Task (Cmd/Ctrl+Shift+P -> "Tasks: Run Task") -> "Dev: start API + web".
  // Opens two terminals side by side, one per server. Both just call scripts/dev.sh.
  // Want to look around with sample data and no setup? Run "Dev: demo (fresh sample data)" (also split API + web).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: API",
      "type": "shell",
      "command": "./scripts/dev.sh backend",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true }
    },
    {
      "label": "Dev: web",
      "type": "shell",
      "command": "./scripts/dev.sh web",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true }
    },
    {
      "label": "Dev: API (demo, fresh data)",
      "type": "shell",
      "command": "./scripts/dev.sh backend",
      "options": { "env": { "MONETARY_DEMO_MODE": "true", "MONETARY_DEMO_RESET": "true" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true }
    },
    {
      "label": "Dev: API (demo, keep my changes)",
      "type": "shell",
      "command": "./scripts/dev.sh backend",
      "options": { "env": { "MONETARY_DEMO_MODE": "true" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always", "clear": true }
    },
    {
      "label": "Dev: demo (fresh sample data)",
      "dependsOn": ["Dev: API (demo, fresh data)", "Dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Dev: demo (keep my changes)",
      "dependsOn": ["Dev: API (demo, keep my changes)", "Dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Dev: start API + web",
      "dependsOn": ["Dev: API", "Dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
