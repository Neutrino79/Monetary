# Copy this file to `.env` (or `.env.local`) and adjust per deployment.
# Every value is optional — anything omitted falls back to a sensible default
# defined in src/config/app.ts.

VITE_APP_NAME=Khata
VITE_APP_TAGLINE=Personal ledger
VITE_APP_LOGO_MARK=₹
VITE_CURRENCY_CODE=INR
VITE_CURRENCY_SYMBOL=₹
VITE_LOCALE=en-IN
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------- Backend
# Point the app at a real backend by setting this ONE value — every service
# in src/lib/api/services builds its request URLs from it. Leave it empty
# (the default) to keep running entirely on the built-in mock backend.
# VITE_API_BASE_URL=https://api.example.com/v1

# Normally inferred from VITE_API_BASE_URL (empty = mock, set = real), but
# you can force either side explicitly if needed:
# VITE_USE_MOCK_API=false

# Request timeout for the real HTTP client, in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Artificial network delay the mock backend simulates, in milliseconds.
VITE_MOCK_LATENCY_MS=260

# Pin the mock backend's "today" to a fixed date instead of the real clock.
# Has no effect once a real backend is configured.
# VITE_FIXED_TODAY=2026-09-23
