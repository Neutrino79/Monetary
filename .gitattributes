# Normalise line endings: LF in the repository, everywhere.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf

# Lockfiles are generated: collapse them in GitHub diffs, never hand-merge them.
web/package-lock.json linguist-generated=true -diff merge=binary
*.lock linguist-generated=true -diff

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
