# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
.Python
build/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
MANIFEST

# Test, coverage, and type-checker output
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Node (the web app lives in web/, which has its own .gitignore)
node_modules/

# Local configuration and secrets -- never commit these; copy .env.example instead
.env
.env.*
!.env.example
*.local
*.secret

# Local application data (SQLite databases)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/

# macOS and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
